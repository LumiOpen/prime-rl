# Run outputs: checkpoints (2.2 TB across ~88 safetensors), rollout traces and
# orchestrator/trainer logs. Regenerated by the sbatch launchers.
runs/
logs/

# Dry-run config dumps (`uv run rl ... --dry-run --output-dir opd_val/dr_*`).
dr_*/
dryrun*/

# Written by the launchers at job start; contain absolute per-job scratch paths.
env_setup*.sh

# Superseded intermediate bands saved via Dataset.save_to_disk. The band the
# committed configs actually point at is data/gsm8k_boxed_band/train.parquet.
data/band_gsm8k_qwen3_1.7b/
data/band_math_qwen3_1.7b/
data/gsm8k_band_qwen3_1.7b/
